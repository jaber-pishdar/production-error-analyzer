{
  "name": "production-error-analyzer",
  "private": true,
  "description": "Turn raw production logs into actionable error intelligence",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @pea/web dev\" \"pnpm --filter @pea/api dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "seed": "node scripts/seed.js",
    "sample-incident": "node scripts/sample-incident.js",
    "demo": "node scripts/demo.js",
    "generate-logs": "node scripts/generate-logs.js",
    "clean": "pnpm -r clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.12",
    "vitest": "^1.6.0"
  }
}